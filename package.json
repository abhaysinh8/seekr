{
  "name": "seekr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted search and recommendation engine.",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "benchmark": "pnpm --filter @seekr/search-core benchmark",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf coverage .turbo",
    "dev": "turbo run dev --parallel",
    "dev:services": "docker compose up -d postgres redis",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @seekr/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.1",
    "@types/node": "catalog:",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
