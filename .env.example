NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Data services
POSTGRES_DB=seekr
POSTGRES_USER=seekr
POSTGRES_PASSWORD=seekr_local_password
DATABASE_URL=postgresql://seekr:seekr_local_password@localhost:5432/seekr
REDIS_URL=redis://localhost:6379

# Durable search files and backups (container defaults are mounted under /data)
SEEKR_INDEX_PATH=./data/index
SEEKR_SNAPSHOT_PATH=./data/snapshots

# API protection and request controls
SEEKR_REQUEST_BODY_LIMIT=1048576
SEEKR_RATE_LIMIT_MAX=120

# Crawler worker (create a documents:write key after project bootstrap)
SEEKR_API_URL=http://localhost:4000
SEEKR_API_KEY=
SEEKR_CRAWL_POLL_MS=1000
