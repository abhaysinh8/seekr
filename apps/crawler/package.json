{
  "name": "@seekr/crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "tsx watch --env-file=../../.env src/runtime.ts",
    "start": "node dist/runtime.js",
    "test": "vitest run --root ../.. apps/crawler/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@seekr/config": "workspace:*",
    "@seekr/shared": "workspace:*",
    "cheerio": "^1.2.0",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
