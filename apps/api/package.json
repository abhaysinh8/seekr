{
  "name": "@seekr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.ts",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "loadtest": "tsx src/load-tests/load-test.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@fastify/sensible": "catalog:",
    "@seekr/config": "workspace:*",
    "@seekr/recommendation-core": "workspace:*",
    "@seekr/search-core": "workspace:*",
    "@seekr/shared": "workspace:*",
    "@seekr/tokenizer": "workspace:*",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "pino-pretty": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
